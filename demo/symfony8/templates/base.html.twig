{#- REQ-DEMO-014: the demo shell is UiKit's admin layout with UiKit's default theme (nowo-ui.css from the bundle's own
    asset package, no CSS framework, no CDN, no inline styles). nowo_ui_kit.layouts.admin points here, so the
    instance-settings pages (UiKit page contract, REQ-UI-003) render inside the same shell. -#}
{% extends '@NowoUiKit/layout/admin.html.twig' %}

{% block nowo_ui_document_title %}{% block title %}SMS Kit Demo{% endblock %}{% endblock %}

{% block nowo_ui_navigation %}
    {% set _route = app.request.attributes.get('_route') %}
    <header class="nowo-ui-header" data-testid="demo-masthead">
        <a class="nowo-ui-brand" href="{{ path('demo_home') }}">SMS Kit Bundle Demo</a>
        <nav class="nowo-ui-menu" aria-label="SMS Kit Bundle Demo">
            <a class="nowo-ui-link" href="{{ path('demo_home') }}"{% if _route == 'demo_home' %} aria-current="page"{% endif %}>Send</a>
            <a class="nowo-ui-link" href="{{ path('nowo_instance_settings_index') }}"{% if _route starts with 'nowo_instance_settings' %} aria-current="page"{% endif %}>Settings</a>
        </nav>
        <div class="nowo-ui-header__end">
            {{ include('@NowoUiKitBundle/partials/_theme_toggle.html.twig', { compact: true }, false) }}
        </div>
    </header>
{% endblock %}

{% block nowo_ui_content %}{% block body %}{% endblock %}{% endblock %}

{% block nowo_ui_scripts %}
    {{ parent() }}
    {# UiKit visible-when peer (provider-dependent SMS fields, InstanceSettings 1.3): demo Stimulus app. #}
    <script src="{{ asset('js/nowo-ui-demo-peers.js') }}" defer></script>
    {% block javascripts %}{% endblock %}
{% endblock %}
